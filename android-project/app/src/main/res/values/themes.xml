<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Реальная тема оформления в этом приложении - Material 3 из
      ui/theme/Theme.kt (Compose). Этот XML-стиль нужен только как тема
      Activity/окна ДО того, как Compose успел отрисоваться (сплэш/фон окна),
      см. https://developer.android.com/develop/ui/compose/theming - для
      Compose-приложений это стандартная и минимальная роль XML-темы.
    -->
    <style name="Theme.AstroStacker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/space_black</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/space_black</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/space_black</item>
    </style>
</resources>
