<?xml version="1.0" encoding="utf-8"?>
<!-- Простой геометрический значок: полумесяц + три звезды. Безопасная зона
     адаптивной иконки - центральные 66dp из 108dp, всё вписано в неё. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Полумесяц: большой белый круг минус чуть смещённый круг цвета фона -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,54 m -20,0 a 20,20 0 1,0 40,0 a 20,20 0 1,0 -40,0" />
    <path
        android:fillColor="#0B0F1A"
        android:pathData="M 68,54 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0" />

    <!-- Три звезды-точки разного размера -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 34,36 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 78,32 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 40,74 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />
</vector>
