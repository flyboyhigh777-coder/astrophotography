    <string name="picker_select_dark_frames">Dark frames (optional)</string>
    <string name="picker_dark_frames_hint">Frames shot with the lens cap on, same shutter speed/ISO — used to remove hot pixels on long exposures.</string>
    <string name="picker_dark_selected_count">Dark frames selected: %1$d</string>
    <string name="picker_start_button">Process</string>
    <string name="picker_min_frames_warning">Please select at least 2 frames</string>

    <string name="processing_title">Processing</string>
    <string name="stage_detect_stars">Detecting stars</string>
    <string name="stage_register">Aligning frames</string>
    <string name="stage_stack">Stacking</string>
    <string name="stage_ground">Ground from the first frame</string>
    <string name="stage_done">Done</string>
