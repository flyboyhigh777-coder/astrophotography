    <string name="app_name">AstroStacker</string>

    <string name="picker_title">Select frames</string>
    <string name="picker_instructions">Pick a series of night-sky photos shot from a tripod (camera did not move between shots). Stars are aligned to the first frame, and the ground is taken from the first frame. At least 2 frames are required; for a visible improvement, 10-15 or more.</string>
    <string name="picker_select_frames">Select frames</string>
